# Copy to `.env` and adjust. Next.js loads this file automatically.

# MongoDB connection. Use a local mongod, or a hosted cluster (e.g. Atlas).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/nextchat

MONGODB_DB=nextchat

# Signing key for sessions. REQUIRED in production — set it to a long random
# string (e.g. `openssl rand -hex 48`). If unset, one is generated once and
# saved to .data/.secret.
JWT_SECRET=

# Port the server listens on.
PORT=3000
